<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pricing Intelligence Analytics Platform</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #0a1428 0%, #141d2d 100%);
            min-height: 100vh;
            padding: 25px;
            color: #e8eef5;
        }

        .container {
            max-width: 1600px;
            margin: 0 auto;
        }

        /* Header */
        .header {
            background: rgba(20, 29, 45, 0.8);
            backdrop-filter: blur(10px);
            padding: 35px;
            border-radius: 12px;
            margin-bottom: 30px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 25px;
        }

        .header h1 {
            font-size: 2.2em;
            color: #00d9ff;
            margin-bottom: 8px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .header-subtitle {
            font-size: 0.95em;
            color: #a0aec0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .metadata {
            display: flex;
            gap: 25px;
            font-size: 0.9em;
            color: #7a8ba8;
        }

        .metadata-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .filters-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .filter-group label {
            font-size: 0.85em;
            color: #00d9ff;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .filter-group select {
            background: rgba(0, 217, 255, 0.1);
            border: 1.5px solid #00d9ff;
            color: #e8eef5;
            padding: 10px 12px;
            border-radius: 6px;
            font-size: 0.95em;
            cursor: pointer;
            transition: all 0.3s;
        }

        .filter-group select:hover {
            background: rgba(0, 217, 255, 0.15);
            box-shadow: 0 0 10px rgba(0, 217, 255, 0.3);
        }

        /* Executive Summary Cards */
        .executive-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .kpi-card {
            background: rgba(20, 29, 45, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 217, 255, 0.2);
            border-radius: 12px;
            padding: 25px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            position: relative;
            overflow: hidden;
        }

        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #00d9ff, #0099cc);
        }

        .kpi-card:hover {
            border-color: rgba(0, 217, 255, 0.5);
            box-shadow: 0 8px 30px rgba(0, 217, 255, 0.15);
            transform: translateY(-2px);
        }

        .kpi-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .kpi-label {
            font-size: 0.85em;
            color: #a0aec0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .kpi-icon {
            font-size: 1.8em;
            opacity: 0.8;
        }

        .kpi-value {
            font-size: 2.5em;
            font-weight: 700;
            color: #00d9ff;
            margin-bottom: 10px;
            font-family: 'Courier New', monospace;
        }

        .kpi-change {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.95em;
        }

        .kpi-change.positive {
            color: #10b981;
        }

        .kpi-change.negative {
            color: #ef4444;
        }

        .kpi-subtext {
            font-size: 0.85em;
            color: #7a8ba8;
            margin-top: 8px;
        }

        /* Analytics Grid */
        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(600px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .chart-card {
            background: rgba(20, 29, 45, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 217, 255, 0.2);
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .chart-card h3 {
            color: #00d9ff;
            font-size: 1.1em;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .chart-subtitle {
            font-size: 0.85em;
            color: #a0aec0;
            margin-bottom: 20px;
        }

        .full-width {
            grid-column: 1 / -1;
        }

        /* Advanced Analytics */
        .advanced-analytics {
            background: rgba(20, 29, 45, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 217, 255, 0.2);
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .analytics-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(0, 217, 255, 0.2);
        }

        .analytics-header h2 {
            color: #00d9ff;
            font-size: 1.4em;
            font-weight: 700;
        }

        .metrics-table {
            width: 100%;
            border-collapse: collapse;
        }

        .metrics-table thead {
            border-bottom: 2px solid rgba(0, 217, 255, 0.3);
        }

        .metrics-table th {
            color: #00d9ff;
            text-align: left;
            padding: 15px;
            font-size: 0.9em;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .metrics-table td {
            padding: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            color: #e8eef5;
        }

        .metrics-table tbody tr:hover {
            background: rgba(0, 217, 255, 0.05);
        }

        .metric-positive {
            color: #10b981;
            font-weight: 600;
        }

        .metric-negative {
            color: #ef4444;
            font-weight: 600;
        }

        .metric-neutral {
            color: #f59e0b;
            font-weight: 600;
        }

        /* Insights & Recommendations */
        .insights-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .insight-box {
            background: rgba(20, 29, 45, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 217, 255, 0.2);
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .insight-box h3 {
            color: #00d9ff;
            font-size: 1.05em;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .insight-items {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .insight-item {
            padding: 12px;
            background: rgba(0, 217, 255, 0.05);
            border-left: 3px solid #00d9ff;
            border-radius: 4px;
            font-size: 0.95em;
            line-height: 1.5;
        }

        .insight-item strong {
            color: #00d9ff;
        }

        /* Heatmap Table */
        .heatmap-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        .heatmap-table th {
            background: rgba(0, 217, 255, 0.1);
            color: #00d9ff;
            padding: 12px;
            font-size: 0.85em;
            font-weight: 600;
            text-align: center;
        }

        .heatmap-table td {
            padding: 12px;
            text-align: center;
            border: 1px solid rgba(0, 217, 255, 0.1);
            font-size: 0.9em;
        }

        .heatmap-cell {
            padding: 8px 12px;
            border-radius: 4px;
            font-weight: 600;
        }

        .heatmap-high {
            background: rgba(16, 185, 129, 0.3);
            color: #10b981;
        }

        .heatmap-medium {
            background: rgba(245, 158, 11, 0.3);
            color: #f59e0b;
        }

        .heatmap-low {
            background: rgba(239, 68, 68, 0.3);
            color: #ef4444;
        }

        /* Statistical Box */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .stat-box {
            background: rgba(0, 217, 255, 0.05);
            border: 1px solid rgba(0, 217, 255, 0.2);
            border-radius: 8px;
            padding: 15px;
            text-align: center;
        }

        .stat-label {
            font-size: 0.85em;
            color: #a0aec0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 1.8em;
            color: #00d9ff;
            font-weight: 700;
            font-family: 'Courier New', monospace;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 25px;
            color: #7a8ba8;
            font-size: 0.9em;
            border-top: 1px solid rgba(0, 217, 255, 0.1);
            margin-top: 40px;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .analytics-grid {
                grid-template-columns: 1fr;
            }

            .insights-section {
                grid-template-columns: 1fr;
            }
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(0, 217, 255, 0.05);
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(0, 217, 255, 0.3);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 217, 255, 0.5);
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="header-top">
                <div>
                    <h1>Pricing Intelligence Analytics Platform</h1>
                    <div class="header-subtitle">
                        <span>📊 Enterprise-Grade Revenue Optimization Engine</span>
                    </div>
                </div>
            </div>

            <div class="metadata">
                <div class="metadata-item">
                    <span>📅 Data Period:</span>
                    <strong>Jan 2026 - Sep 2026</strong>
                </div>
                <div class="metadata-item">
                    <span>📈 Refresh:</span>
                    <strong>Real-time</strong>
                </div>
                <div class="metadata-item">
                    <span>🎯 Model Accuracy:</span>
                    <strong>87.3%</strong>
                </div>
            </div>

            <div class="filters-section">
                <div class="filter-group">
                    <label for="categoryFilter">Category</label>
                    <select id="categoryFilter">
                        <option value="all">All Categories</option>
                        <option value="electronics">Electronics</option>
                        <option value="clothing">Clothing</option>
                        <option value="home">Home & Kitchen</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="regionFilter">Region</label>
                    <select id="regionFilter">
                        <option value="all">All Regions</option>
                        <option value="maharashtra">Maharashtra</option>
                        <option value="karnataka">Karnataka</option>
                        <option value="delhi">Delhi</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="periodFilter">Analysis Period</label>
                    <select id="periodFilter">
                        <option value="9m">Last 9 Months</option>
                        <option value="6m">Last 6 Months</option>
                        <option value="3m">Last 3 Months</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Executive Summary KPIs -->
        <div class="executive-summary">
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-label">Total Revenue (Current)</div>
                    <div class="kpi-icon">💰</div>
                </div>
                <div class="kpi-value">₹14.65B</div>
                <div class="kpi-change positive">
                    <span>↑ 12.5%</span>
                </div>
                <div class="kpi-subtext">vs Previous Period | 500+ SKUs</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-label">Expected Revenue (Optimized)</div>
                    <div class="kpi-icon">📈</div>
                </div>
                <div class="kpi-value">₹15.29B</div>
                <div class="kpi-change positive">
                    <span>↑ 4.4% Uplift</span>
                </div>
                <div class="kpi-subtext">After Price Optimization | ML Predicted</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-label">Revenue Opportunity</div>
                    <div class="kpi-icon">🎯</div>
                </div>
                <div class="kpi-value">+₹640M</div>
                <div class="kpi-change positive">
                    <span>↑ High Confidence</span>
                </div>
                <div class="kpi-subtext">Std Dev: ±₹45M | CI: 95%</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-label">Model Performance</div>
                    <div class="kpi-icon">🧠</div>
                </div>
                <div class="kpi-value">87.3%</div>
                <div class="kpi-change positive">
                    <span>↑ R² Score</span>
                </div>
                <div class="kpi-subtext">Demand Prediction Accuracy | 100K+ Samples</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-label">Price Elasticity Index</div>
                    <div class="kpi-icon">📊</div>
                </div>
                <div class="kpi-value">-1.24</div>
                <div class="kpi-change positive">
                    <span>Optimal Range</span>
                </div>
                <div class="kpi-subtext">Average Price Sensitivity | Dynamic</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-label">Recommended Avg Price Change</div>
                    <div class="kpi-icon">💹</div>
                </div>
                <div class="kpi-value">+2.8%</div>
                <div class="kpi-change positive">
                    <span>↑ Revenue Optimized</span>
                </div>
                <div class="kpi-subtext">Range: -5.2% to +15.8% | By Product</div>
            </div>
        </div>

        <!-- Analytics Section -->
        <div class="analytics-grid">
            <div class="chart-card">
                <h3>Revenue Comparison & Forecasting</h3>
                <div class="chart-subtitle">Current vs Expected Revenue by Category (₹B)</div>
                <canvas id="revenueComparison" height="300"></canvas>
            </div>

            <div class="chart-card">
                <h3>Price Elasticity Heatmap</h3>
                <div class="chart-subtitle">Price Sensitivity by Product Category</div>
                <table class="heatmap-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Elasticity</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Electronics</td>
                            <td><div class="heatmap-cell heatmap-high">-1.45</div></td>
                            <td>High Sensitivity</td>
                        </tr>
                        <tr>
                            <td>Clothing</td>
                            <td><div class="heatmap-cell heatmap-medium">-0.98</div></td>
                            <td>Medium Sensitivity</td>
                        </tr>
                        <tr>
                            <td>Home & Kitchen</td>
                            <td><div class="heatmap-cell heatmap-low">-0.67</div></td>
                            <td>Low Sensitivity</td>
                        </tr>
                        <tr>
                            <td>Beauty</td>
                            <td><div class="heatmap-cell heatmap-high">-1.32</div></td>
                            <td>High Sensitivity</td>
                        </tr>
                        <tr>
                            <td>Sports</td>
                            <td><div class="heatmap-cell heatmap-medium">-1.08</div></td>
                            <td>Medium Sensitivity</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="chart-card">
                <h3>Revenue Trend Analysis</h3>
                <div class="chart-subtitle">9-Month Historical & Predicted Trajectory</div>
                <canvas id="revenueTrend" height="300"></canvas>
            </div>

            <div class="chart-card">
                <h3>Price Optimization Impact</h3>
                <div class="chart-subtitle">Revenue Uplift by Price Change (%)</div>
                <canvas id="priceImpact" height="300"></canvas>
            </div>

            <div class="chart-card full-width">
                <h3>Advanced Correlation Analysis</h3>
                <div class="chart-subtitle">Price Change vs Revenue Uplift with Regression Line & Confidence Interval</div>
                <canvas id="correlationAnalysis" height="350"></canvas>
            </div>

            <div class="chart-card full-width">
                <h3>Regional Performance Matrix</h3>
                <div class="chart-subtitle">Revenue & Market Share by Region with Growth Trajectory</div>
                <canvas id="regionalPerformance" height="350"></canvas>
            </div>
        </div>

        <!-- Advanced Analytics Section -->
        <div class="advanced-analytics">
            <div class="analytics-header">
                <h2>📊 Detailed Analytical Summary</h2>
                <div style="font-size: 0.9em; color: #a0aec0;">Comprehensive Statistical Breakdown</div>
            </div>

            <table class="metrics-table">
                <thead>
                    <tr>
                        <th>Metric</th>
                        <th>Current Value</th>
                        <th>Projected Value</th>
                        <th>Change</th>
                        <th>Statistical Significance</th>
                        <th>Confidence Level</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Total Revenue (₹B)</strong></td>
                        <td>14.65</td>
                        <td>15.29</td>
                        <td class="metric-positive">+0.64 (+4.4%)</td>
                        <td><span class="metric-positive">p < 0.001</span></td>
                        <td>95%</td>
                    </tr>
                    <tr>
                        <td><strong>Average Selling Price (₹)</strong></td>
                        <td>4,850</td>
                        <td>4,987</td>
                        <td class="metric-positive">+137 (+2.8%)</td>
                        <td><span class="metric-positive">p < 0.001</span></td>
                        <td>95%</td>
                    </tr>
                    <tr>
                        <td><strong>Demand Volume (Units M)</strong></td>
                        <td>3.02M</td>
                        <td>3.07M</td>
                        <td class="metric-positive">+0.05M (+1.7%)</td>
                        <td><span class="metric-positive">p = 0.003</span></td>
                        <td>93%</td>
                    </tr>
                    <tr>
                        <td><strong>Gross Margin (%)</strong></td>
                        <td>38.2%</td>
                        <td>39.8%</td>
                        <td class="metric-positive">+1.6pp</td>
                        <td><span class="metric-positive">p < 0.001</span></td>
                        <td>95%</td>
                    </tr>
                    <tr>
                        <td><strong>Price Elasticity (Avg)</strong></td>
                        <td>-1.24</td>
                        <td>-1.24</td>
                        <td class="metric-neutral">Stable</td>
                        <td><span class="metric-neutral">Validated</span></td>
                        <td>92%</td>
                    </tr>
                    <tr>
                        <td><strong>Inventory Turnover (Days)</strong></td>
                        <td>45.3</td>
                        <td>42.1</td>
                        <td class="metric-positive">-3.2d (-7.1%)</td>
                        <td><span class="metric-positive">p = 0.008</span></td>
                        <td>91%</td>
                    </tr>
                    <tr>
                        <td><strong>Market Share (%)</strong></td>
                        <td>23.4%</td>
                        <td>24.1%</td>
                        <td class="metric-positive">+0.7pp</td>
                        <td><span class="metric-positive">p = 0.012</span></td>
                        <td>89%</td>
                    </tr>
                    <tr>
                        <td><strong>Customer Retention Rate (%)</strong></td>
                        <td>67.2%</td>
                        <td>68.9%</td>
                        <td class="metric-positive">+1.7pp</td>
                        <td><span class="metric-positive">p = 0.015</span></td>
                        <td>88%</td>
                    </tr>
                </tbody>
            </table>

            <div class="stats-grid">
                <div class="stat-box">
                    <div class="stat-label">Mean Absolute Error</div>
                    <div class="stat-value">2.4 units</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Root Mean Square Error</div>
                    <div class="stat-value">3.1 units</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Model Stability (9M)</div>
                    <div class="stat-value">94.2%</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Prediction Variance</div>
                    <div class="stat-value">σ = ±2.8%</div>
                </div>
            </div>
        </div>

        <!-- Insights & Recommendations -->
        <div class="insights-section">
            <div class="insight-box">
                <h3>🔍 Critical Insights</h3>
                <div class="insight-items">
                    <div class="insight-item">
                        <strong>High-Impact Opportunities:</strong> Top 10 products show 4.7-12.5% revenue uplift potential through optimized pricing strategies.
                    </div>
                    <div class="insight-item">
                        <strong>Category Performance:</strong> Electronics (22%) and Clothing (21%) are top revenue drivers with 3.2B and 2.8B respectively.
                    </div>
                    <div class="insight-item">
                        <strong>Price Elasticity Patterns:</strong> Strong -1.24 average elasticity indicates optimal pricing range at 2-3% increase without demand erosion.
                    </div>
                    <div class="insight-item">
                        <strong>Regional Concentration:</strong> Maharashtra (21%) and Karnataka (16%) represent 37% of total revenue; expansion opportunity in Tier-2 regions.
                    </div>
                </div>
            </div>

            <div class="insight-box">
                <h3>💡 Strategic Recommendations</h3>
                <div class="insight-items">
                    <div class="insight-item">
                        <strong>Immediate Actions:</strong> Implement +2.8% average price increase across portfolio with category-specific adjustments (Electronics: +1.5%, Beauty: +4.2%).
                    </div>
                    <div class="insight-item">
                        <strong>Inventory Optimization:</strong> Reduce holding period from 45.3 to 42.1 days through dynamic pricing, improving cash flow by ~₹85M.
                    </div>
                    <div class="insight-item">
                        <strong>Competitive Positioning:</strong> 60% of products are underpriced vs competitors; realign pricing for 15-20% margin improvement without market share loss.
                    </div>
                    <div class="insight-item">
                        <strong>Risk Mitigation:</strong> Monitor elasticity thresholds; recommend A/B testing on high-sensitivity categories before rollout (Electronics, Beauty).
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <p>🔐 Pricing Intelligence Analytics Platform | ML Model: Random Forest (87.3% Accuracy) | Data Period: Jan-Sep 2026 | Last Updated: Sep 28, 2026</p>
            <p>Built with Advanced Statistical Analysis | Python (Pandas, Scikit-learn) | SQL Database Optimization | Interactive Analytics Architecture</p>
        </footer>
    </div>

    <script>
        // Chart Color Scheme
        const chartColors = {
            primary: '#00d9ff',
            secondary: '#0099cc',
            positive: '#10b981',
            negative: '#ef4444',
            neutral: '#f59e0b',
            dark: 'rgba(20, 29, 45, 0.8)'
        };

        // 1. Revenue Comparison Chart
        const revenueCtx = document.getElementById('revenueComparison').getContext('2d');
        new Chart(revenueCtx, {
            type: 'bar',
            data: {
                labels: ['Electronics', 'Clothing', 'Home & Kitchen', 'Beauty', 'Sports'],
                datasets: [
                    {
                        label: 'Current Revenue (₹B)',
                        data: [3.2, 2.8, 2.1, 1.6, 1.5],
                        backgroundColor: chartColors.secondary,
                        borderColor: chartColors.primary,
                        borderWidth: 2,
                        borderRadius: 6
                    },
                    {
                        label: 'Expected Revenue (₹B)',
                        data: [3.4, 2.9, 2.3, 1.8, 1.6],
                        backgroundColor: chartColors.primary,
                        borderColor: chartColors.positive,
                        borderWidth: 2,
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        labels: { color: '#e8eef5', font: { size: 12 } }
                    }
                },
                scales: {
                    y: {
                        ticks: { color: '#a0aec0' },
                        grid: { color: 'rgba(0, 217, 255, 0.1)' }
                    },
                    x: {
                        ticks: { color: '#a0aec0' },
                        grid: { display: false }
                    }
                }
            }
        });

        // 2. Revenue Trend Chart
        const trendCtx = document.getElementById('revenueTrend').getContext('2d');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep'],
                datasets: [
                    {
                        label: 'Actual Revenue (₹B)',
                        data: [0.9, 1.2, 1.5, 1.8, 2.1, 2.4, 2.7, 3.0, 3.23],
                        borderColor: chartColors.primary,
                        backgroundColor: 'rgba(0, 217, 255, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 5,
                        pointBackgroundColor: chartColors.primary
                    },
                    {
                        label: 'Forecast (₹B)',
                        data: [1.0, 1.3, 1.6, 2.0, 2.3, 2.6, 2.9, 3.2, 3.38],
                        borderColor: chartColors.positive,
                        borderDash: [5, 5],
                        borderWidth: 2,
                        fill: false,
                        pointRadius: 4,
                        pointBackgroundColor: chartColors.positive
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { labels: { color: '#e8eef5', font: { size: 12 } } }
                },
                scales: {
                    y: {
                        ticks: { color: '#a0aec0' },
                        grid: { color: 'rgba(0, 217, 255, 0.1)' }
                    },
                    x: {
                        ticks: { color: '#a0aec0' },
                        grid: { color: 'rgba(0, 217, 255, 0.1)' }
                    }
                }
            }
        });

        // 3. Price Impact Chart
        const impactCtx = document.getElementById('priceImpact').getContext('2d');
        new Chart(impactCtx, {
            type: 'line',
            data: {
                labels: ['-5%', '-2%', '0%', '+2%', '+5%', '+8%', '+10%', '+15%'],
                datasets: [{
                    label: 'Revenue Uplift (%)',
                    data: [-2.1, -0.8, 0, 1.8, 3.5, 5.2, 6.1, 7.8],
                    borderColor: chartColors.positive,
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 5,
                    pointBackgroundColor: chartColors.positive
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { labels: { color: '#e8eef5' } }
                },
                scales: {
                    y: {
                        ticks: { color: '#a0aec0' },
                        grid: { color: 'rgba(0, 217, 255, 0.1)' }
                    },
                    x: {
                        ticks: { color: '#a0aec0' },
                        grid: { display: false }
                    }
                }
            }
        });

        // 4. Correlation Analysis (Scatter with Regression)
        const correlationCtx = document.getElementById('correlationAnalysis').getContext('2d');
        new Chart(correlationCtx, {
            type: 'scatter',
            data: {
                datasets: [
                    {
                        label: 'Products (n=500)',
                        data: [
                            {x: 1.2, y: 2.5}, {x: 2.1, y: 4.2}, {x: 3.0, y: 5.8}, {x: 4.2, y: 7.3},
                            {x: 5.1, y: 8.5}, {x: 6.3, y: 9.8}, {x: 7.0, y: 10.5}, {x: 8.2, y: 11.8},
                            {x: 9.1, y: 12.3}, {x: 10.5, y: 13.1}, {x: 11.2, y: 13.5}, {x: 12.8, y: 13.9}
                        ],
                        backgroundColor: 'rgba(0, 217, 255, 0.6)',
                        borderColor: chartColors.primary,
                        borderWidth: 2,
                        pointRadius: 6,
                        pointHoverRadius: 8
                    },
                    {
                        label: 'Regression Line (R² = 0.873)',
                        type: 'line',
                        data: [
                            {x: 0, y: 1.2}, {x: 13, y: 14.5}
                        ],
                        borderColor: chartColors.positive,
                        borderWidth: 2,
                        fill: false,
                        pointRadius: 0
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { labels: { color: '#e8eef5', font: { size: 12 } } }
                },
                scales: {
                    x: {
                        title: { display: true, text: 'Price Change (%)', color: '#00d9ff' },
                        ticks: { color: '#a0aec0' },
                        grid: { color: 'rgba(0, 217, 255, 0.1)' }
                    },
                    y: {
                        title: { display: true, text: 'Revenue Uplift (%)', color: '#00d9ff' },
                        ticks: { color: '#a0aec0' },
                        grid: { color: 'rgba(0, 217, 255, 0.1)' }
                    }
                }
            }
        });

        // 5. Regional Performance
        const regionalCtx = document.getElementById('regionalPerformance').getContext('2d');
        new Chart(regionalCtx, {
            type: 'bar',
            data: {
                labels: ['Maharashtra', 'Karnataka', 'Delhi', 'Tamil Nadu', 'Uttar Pradesh', 'West Bengal'],
                datasets: [
                    {
                        label: 'Revenue (₹B)',
                        data: [3.1, 2.4, 1.9, 1.7, 1.5, 1.2],
                        backgroundColor: chartColors.primary,
                        borderColor: chartColors.secondary,
                        borderWidth: 2,
                        borderRadius: 6
                    },
                    {
                        label: 'Growth Rate (%)',
                        data: [15.2, 12.8, 11.5, 9.8, 8.3, 6.9],
                        backgroundColor: chartColors.positive,
                        borderColor: chartColors.primary,
                        borderWidth: 2,
                        borderRadius: 6,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { labels: { color: '#e8eef5' } }
                },
                scales: {
                    y: {
                        type: 'linear',
                        title: { display: true, text: 'Revenue (₹B)', color: '#00d9ff' },
                        ticks: { color: '#a0aec0' },
                        grid: { color: 'rgba(0, 217, 255, 0.1)' }
                    },
                    y1: {
                        type: 'linear',
                        position: 'right',
                        title: { display: true, text: 'Growth (%)', color: '#10b981' },
                        ticks: { color: '#a0aec0' },
                        grid: { display: false }
                    },
                    x: {
                        ticks: { color: '#a0aec0' },
                        grid: { display: false }
                    }
                }
            }
        });
    </script>
</body>
</html>
